# Postgres Database Config
POSTGRES_USER=my_db_user
POSTGRES_PASSWORD=my_db_password
POSTGRES_DB=my_database_name

# Backend Database Connection
# Khi chạy bằng Docker Compose:
DATABASE_URL=postgresql://my_db_user:my_db_password@postgres:5432/my_database_name
# Khi chạy Backend cục bộ (không dùng Docker):
# DATABASE_URL=postgresql://my_db_user:my_db_password@localhost:5433/my_database_name

# Service URLs (Giao tiếp nội bộ trong Docker)
AI_SERVICE_URL=http://ai-service:8001
CRAWLER_SERVICE_URL=http://crawler-service:8002
BACKEND_URL=http://backend:8000

# URL collection uses your Lazada cookie; no TinyFish API key is needed.
# Copy ONLY the Cookie header value from a successful getReviewList request.
# Keep it on one line in single quotes, without the Cookie: prefix or backticks.
# Keep the real cookie only in local .env; never commit or share it.
LAZADA_COOKIE=''
# Compose sets LAZADA_ENV_FILE=/run/duancntt/config/.env.
# The cookie is re-read for each new crawl; no restart is needed after editing it.
# User-Agent is supplied by curl_cffi automatically; no extra setting is required.

# AI Service Environment
APP_ENV=development

# Account login and reset-password emails (Mailpit is included in Compose).
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=DuanCNTT <no-reply@duancntt.local>
# For real SMTP later: SMTP_USERNAME, SMTP_PASSWORD, SMTP_STARTTLS=true
